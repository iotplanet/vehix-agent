# Vehix Agent — host nginx config snippet
#
# Add this SINGLE location block inside your existing HTTPS server {} block.
# The internal Docker nginx handles all sub-routing (frontend, API, MCP, docs).
# Assumes docker compose is running with the nginx aggregator on :8080.
#
# Architecture: Host Nginx → Internal Nginx (aggregator) → backend / frontend

location /vehix/ {
    proxy_pass http://127.0.0.1:8080/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
}
