# 高德地图 JSAPI Key
# 获取地址: https://console.amap.com/dev/key/app
VITE_AMAP_KEY=your_amap_key_here

# 部署子路径：
#   本地 Vite 开发默认 "/"（与 vite.config 一致）
#   Docker 子路径部署默认 "/vehix/"（见 docker-compose.yml）
#   裸端口访问 http://localhost:8080 时设为 "/"
# VITE_BASE_URL=/

# 仅本地开发：登录页展示演示账号提示（生产勿开）
# VITE_SHOW_DEMO_CREDENTIALS=true
